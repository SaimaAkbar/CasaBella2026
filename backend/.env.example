DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hotel-residences-pos?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"
# Comma-separated origins. Include the public website (e.g. Next on :3001):
# FRONTEND_URL=http://localhost:5173,http://localhost:3001
FRONTEND_URL=http://localhost:5173
APPLICATION_VERSION=1.0.0
BODY_SIZE_LIMIT=1mb
THROTTLE_LIMIT=600

# Backup / restore (Super Admin only)
BACKUP_DIRECTORY=
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=false
AUTO_BACKUP_CRON=0 2 * * *

# ─── Online booking / Casa Bella website ─────────────────────────────────────
# Public booking site origin (also merged into CORS with FRONTEND_URL)
WEBSITE_URL=http://localhost:3001
# Minutes to hold a PENDING ONLINE booking before auto-cancel / slot release
ONLINE_BOOKING_HOLD_MINUTES=15

# Payment provider for verified online checkout (required to confirm bookings).
# - safepay + sandbox/production + API keys = REAL card payments on Safepay hosted page
# - mock = local test only (NO money collected) — do not use for live customers
#
# SECURITY: Never put owner debit/credit card numbers, CVV, PIN, or OTP here.
# Customers pay on Safepay. Money settles to your Safepay merchant account.
# bank_transfer (default) | safepay | mock
ONLINE_PAYMENT_PROVIDER=bank_transfer
SAFE_PAY_ENVIRONMENT=sandbox
SAFE_PAY_API_KEY=
SAFE_PAY_SECRET_KEY=
SAFE_PAY_WEBHOOK_SECRET=
SAFE_PAY_INTENT=CYBERSOURCE

# Optional outbound email (skipped with a warning when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=
